npts 126 126 126                     # num.grid points in xyz
gridfld PRDX6_model1.maps.fld        # grid_data_file
spacing 0.475                        # spacing(A)
receptor_types A C N NA OA SA        # receptor atom types
ligand_types A C HD N NA OA SA       # ligand atom types
receptor PRDX6_model1.pdbqt          # macromolecule
gridcenter -1.285 -1.342 0.837       # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map PRDX6_model1.A.map               # atom-specific affinity map
map PRDX6_model1.C.map               # atom-specific affinity map
map PRDX6_model1.HD.map              # atom-specific affinity map
map PRDX6_model1.N.map               # atom-specific affinity map
map PRDX6_model1.NA.map              # atom-specific affinity map
map PRDX6_model1.OA.map              # atom-specific affinity map
map PRDX6_model1.SA.map              # atom-specific affinity map
elecmap PRDX6_model1.e.map           # electrostatic potential map
dsolvmap PRDX6_model1.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant

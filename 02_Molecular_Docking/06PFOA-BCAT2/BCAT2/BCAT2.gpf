npts 126 126 126                     # num.grid points in xyz
gridfld BCAT2.maps.fld               # grid_data_file
spacing 0.469444444444               # spacing(A)
receptor_types A C N NA OA SA        # receptor atom types
ligand_types A C HD N NA OA SA       # ligand atom types
receptor BCAT2.pdbqt                 # macromolecule
gridcenter -5.196 2.277 -2.668       # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map BCAT2.A.map                      # atom-specific affinity map
map BCAT2.C.map                      # atom-specific affinity map
map BCAT2.HD.map                     # atom-specific affinity map
map BCAT2.N.map                      # atom-specific affinity map
map BCAT2.NA.map                     # atom-specific affinity map
map BCAT2.OA.map                     # atom-specific affinity map
map BCAT2.SA.map                     # atom-specific affinity map
elecmap BCAT2.e.map                  # electrostatic potential map
dsolvmap BCAT2.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
